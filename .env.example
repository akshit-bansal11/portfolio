# Blog likes and comments (Cloudflare D1 over its REST API). Leave empty to disable the feature.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# API token with the "D1 Edit" permission (Account level), scoped to this account.
CLOUDFLARE_D1_API_TOKEN=
# Random string used to hash visitor IPs. Never commit a real value.
ENGAGEMENT_IP_SALT=
